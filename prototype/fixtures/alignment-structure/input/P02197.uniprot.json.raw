{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"P02197","secondaryAccessions":["P02198"],"uniProtkbId":"MYG_CHICK","entryAudit":{"firstPublicDate":"1986-07-21","lastAnnotationUpdateDate":"2026-06-10","lastSequenceUpdateDate":"2007-01-23","entryVersion":150,"sequenceVersion":4},"annotationScore":4.0,"organism":{"scientificName":"Gallus gallus","commonName":"Chicken","taxonId":9031,"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Archelosauria","Archosauria","Dinosauria","Saurischia","Theropoda","Coelurosauria","Aves","Neognathae","Galloanserae","Galliformes","Phasianidae","Phasianinae","Gallus"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"Myoglobin"}},"alternativeNames":[{"fullName":{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"Nitrite reductase MB"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"1.7.-.-"}]},{"fullName":{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"Pseudoperoxidase MB"},"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"1.11.1.-"}]}]},"genes":[{"geneName":{"value":"MB"}}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"Monomeric heme protein which primary function is to store oxygen and facilitate its diffusion within muscle tissues. Reversibly binds oxygen through a pentacoordinated heme iron and enables its timely and efficient release as needed during periods of heightened demand. Depending on the oxidative conditions of tissues and cells, and in addition to its ability to bind oxygen, it also has a nitrite reductase activity whereby it regulates the production of bioactive nitric oxide. Under stress conditions, like hypoxia and anoxia, it also protects cells against reactive oxygen species thanks to its pseudoperoxidase activity"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"Fe(III)-heme b-[protein] + nitric oxide + H2O = Fe(II)-heme b-[protein] + nitrite + 2 H(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:77711"},{"database":"Rhea","id":"RHEA-COMP:18975"},{"database":"Rhea","id":"RHEA-COMP:18976"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:16301"},{"database":"ChEBI","id":"CHEBI:16480"},{"database":"ChEBI","id":"CHEBI:55376"},{"database":"ChEBI","id":"CHEBI:60344"}],"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}]},"physiologicalReactions":[{"directionType":"right-to-left","reactionCrossReference":{"database":"Rhea","id":"RHEA:77713"},"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}]}]},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"H2O2 + AH2 = A + 2 H2O","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:30275"},{"database":"ChEBI","id":"CHEBI:13193"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:16240"},{"database":"ChEBI","id":"CHEBI:17499"}],"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02185"}],"value":"Monomeric"}],"commentType":"SUBUNIT"},{"commentType":"SUBCELLULAR LOCATION","subcellularLocations":[{"location":{"evidences":[{"evidenceCode":"ECO:0000250","source":"UniProtKB","id":"P02144"}],"value":"Cytoplasm, sarcoplasm","id":"SL-0311"}}]},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"PROSITE-ProRule","id":"PRU00238"}],"value":"Belongs to the globin family"}],"commentType":"SIMILARITY"}],"features":[{"type":"Initiator methionine","location":{"start":{"value":1,"modifier":"EXACT"},"end":{"value":1,"modifier":"EXACT"}},"description":"Removed","evidences":[{"evidenceCode"