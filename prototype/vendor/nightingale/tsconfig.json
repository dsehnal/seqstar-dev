{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "declaration": false,
    "declarationMap": false,
    "strict": true,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  }
}
